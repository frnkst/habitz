# Public Supabase connection values. The publishable key is safe for browsers;
# database access is still protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only deployment configuration. Never commit real values.
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Zurich
WEEK_START=1
ALLOWED_GITHUB_USER_ID=12345678

# Ordered JSON array. Supported types: duration, boolean, and measurement.
# Supported icons: activity, brain, candy, check, dumbbell, glass-water, piano, scale, screen-off.
# Optional excludedWeekdays uses 0=Sunday through 6=Saturday.
HABIT_CONFIG_JSON=[{"key":"example-duration","label":"Practice","type":"duration","target":15,"unit":"min","icon":"activity","presets":[5,15]},{"key":"example-measurement","label":"Weight","type":"measurement","unit":"kg","min":20,"max":300,"step":0.1,"icon":"scale"},{"key":"example-boolean","label":"Daily choice","type":"boolean","icon":"check","excludedWeekdays":[2]}]

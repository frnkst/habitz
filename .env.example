# Public Supabase connection values. The publishable key is safe for browsers;
# database access is still protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only deployment configuration. Never commit real values.
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Zurich
WEEK_START=1
ALLOWED_GITHUB_USER_ID=12345678

# Ordered JSON array. Supported types: "duration" and "boolean".
# Supported icons: activity, brain, candy, check, dumbbell, glass-water, piano, screen-off.
HABIT_CONFIG_JSON=[{"key":"example-duration","label":"Practice","type":"duration","target":15,"unit":"min","icon":"activity","presets":[5,15]},{"key":"example-boolean","label":"Daily choice","type":"boolean","icon":"check"}]
